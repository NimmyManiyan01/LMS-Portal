MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-long-random-otp-secret
SESSION_SECRET=replace-with-a-long-random-session-secret
CLIENT_ORIGIN=http://localhost:5173,https://white-island-06c11b900.5.azurestaticapps.net
NODE_ENV=development
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=KGS Exam Portal
DEMO_ADMIN_EMAILS=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-demo-password
# Optional Redis Configuration (Supports Azure Cache for Redis e.g., rediss://:key@host:6380)
# Falls back to high-speed in-memory cache if omitted
REDIS_URL=redis://127.0.0.1:6379
# MongoDB Connection Pool (Default: 100 for high concurrency)
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
